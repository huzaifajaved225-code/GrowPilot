# ─────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=GrowPilot

# ─────────────────────────────────────────────
# DATABASE (PostgreSQL — Prisma)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://growpilot:growpilot123@localhost:5432/growpilot?schema=public"
DIRECT_URL="postgresql://growpilot:growpilot123@localhost:5432/growpilot?schema=public"
# ─────────────────────────────────────────────
# AUTH.JS
# ─────────────────────────────────────────────
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─────────────────────────────────────────────
# TRANSACTIONAL EMAIL
# ─────────────────────────────────────────────
EMAIL_FROM="GrowPilot <noreply@growpilot.app>"
RESEND_API_KEY=

# ─────────────────────────────────────────────
# BILLING (Stripe)
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─────────────────────────────────────────────
# AI PROVIDERS
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# ─────────────────────────────────────────────
# GOOGLE INTEGRATIONS (Business Profile, Analytics, Search Console)
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/webhooks/google

# ─────────────────────────────────────────────
# CACHE / QUEUE (Redis)
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────
# OBSERVABILITY
# ─────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
