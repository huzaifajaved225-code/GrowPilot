    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "vitest": "^3.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@testing-library/react": "^16.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "jsdom": "^26.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
