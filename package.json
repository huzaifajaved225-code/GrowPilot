{
  "name": "growpilot",
  "version": "0.1.0",
  "private": true,
  "description": "GrowPilot — AI-powered business growth platform (SEO, GEO, AEO, content, analytics, GBP, social).",
  "author": "GrowPilot",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
"scripts": {
  "dev": "next dev",
  "build": "next build",
  "start": "next start",
  "lint": "next lint",
  "lint:fix": "next lint --fix",
  "format": "prettier --write .",
  "format:check": "prettier --check .",
  "typecheck": "tsc --noEmit",
  "test": "vitest run",
  "test:watch": "vitest",
  "prepare": "husky",
